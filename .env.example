# Local NeuroSense development settings.
# Keep the real .env file untracked and never commit credentials.

NEUROSENSE_ENV=development
NEUROSENSE_DB_PATH=data/local/neurosense.db

# Firebase Web App configuration (browser-visible values).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=

# Firebase Admin service-account JSON (private; do not commit).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Firebase Storage bucket for persistent per-user music uploads.
# Example: your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=

# Optional Twilio WhatsApp sender credentials. Keep these secret.
# TWILIO_WHATSAPP_FROM must include the whatsapp: prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Local fallback only; hosted filesystems may be ephemeral.
NEUROSENSE_MUSIC_DIR=data/music
# Google Picker API configuration (public browser key + Google Cloud project number).
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
