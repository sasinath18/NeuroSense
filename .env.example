# Local NeuroSense development settings.
# Keep the real .env file untracked and never commit credentials.

NEUROSENSE_ENV=development
NEUROSENSE_DB_PATH=data/local/neurosense.db

# Firebase Web App configuration (browser-visible values).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=

# Firebase Admin service-account JSON (private; do not commit).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Firebase Storage bucket for persistent per-user music uploads.
# Example: your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=

# Optional Twilio WhatsApp sender credentials. Keep these secret.
# TWILIO_WHATSAPP_FROM must include the whatsapp: prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Local fallback only; hosted filesystems may be ephemeral.
NEUROSENSE_MUSIC_DIR=data/music
# Google Picker API configuration (public browser key + Google Cloud project number).
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=

# Telegram emergency-alert bot (created with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NeuroSense_Wellness_Alert_Bot
# Public HTTPS base URL; Render's RENDER_EXTERNAL_URL is used when omitted.
NEUROSENSE_PUBLIC_URL=https://neurosense-app.onrender.com

# AFFEC face-only felt-valence model (research estimate; not a stress score).
# The Google Drive file must be shared as "Anyone with the link - Viewer".
# Set the URL only in the deployment secret/environment, not in this file.
NEUROSENSE_FACE_VALENCE_MODEL_URL=
NEUROSENSE_FACE_VALENCE_MODEL_SHA256=
NEUROSENSE_FACE_VALENCE_MODEL_PATH=ml_model/face_valence/neurosense_face_valence_rf.joblib
OPENFACE_ROOT=/opt/OpenFace
OPENFACE_FEATURE_EXTRACTION_PATH=/opt/OpenFace/build/bin/FeatureExtraction
